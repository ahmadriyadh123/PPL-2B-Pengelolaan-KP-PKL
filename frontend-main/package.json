    "eject": "react-scripts eject",
    "lint": "eslint \"src/**/*.js\"",
    "start": "node -e \"const { execSync } = require('child_process'); const major = parseInt(process.versions.node.split('.')[0]); if (major >= 17) process.env.NODE_OPTIONS = '--openssl-legacy-provider --max-old-space-size=4096'; execSync('craco start', { stdio: 'inherit' });\"",
